# Copy to /etc/home-virtual-router/router.env and replace interface/address examples.
# "physical" is the legacy compatibility name for pre-existing host-visible
# interfaces. UTM/QEMU VirtIO or other VM Ethernet interfaces are supported;
# bare-metal PCI/USB hardware is not required. Never guess interface names.
# Parsed strictly as data. This complete file intentionally does not inherit tracked defaults.
DEPLOYMENT_MODE=physical
PHYSICAL_WAN_INTERFACE=enp2s0
PHYSICAL_LAN_INTERFACE=enp3s0
PHYSICAL_TELEMETRY_INTERFACE=none
# Use static for the legacy configured-address lifecycle. For ordinary upstream
# CPE DHCP, set dhcp and omit the next three PHYSICAL_WAN_* static values.
PHYSICAL_WAN_MODE=static
PHYSICAL_WAN_ADDRESS=203.0.113.2
PHYSICAL_WAN_PREFIX_LENGTH=24
PHYSICAL_WAN_GATEWAY=203.0.113.1
PHYSICAL_MANAGEMENT_INTERFACE_ACK=none
UPSTREAM_SUBNET=192.0.2.0/24
UPSTREAM_GATEWAY=192.0.2.1
ROUTER_WAN=192.0.2.2
LAN_SUBNET=10.0.0.0/24
ROUTER_LAN=10.0.0.1
CLIENT_ADDRESS=10.0.0.10
UPSTREAM_NAMESPACE=hvr-upstream
ROUTER_NAMESPACE=hvr-router
CLIENT_NAMESPACE=hvr-client
UPSTREAM_INTERFACE=hvr-up
ROUTER_WAN_INTERFACE=hvr-wan
ROUTER_LAN_INTERFACE=hvr-lan
CLIENT_INTERFACE=hvr-client
NAT_TABLE=hvr-nat
NAT_CHAIN=hvr-postrouting
FILTER_TABLE=hvr-filter
FILTER_CHAIN=hvr-forward
DHCP_RANGE_START=10.0.0.100
DHCP_RANGE_END=10.0.0.199
DHCP_LEASE_TIME=12h
DHCP_DNS_SERVER=10.0.0.1
DNS_UPSTREAM=1.1.1.1
DNS_CACHE_SIZE=150
DNS_TEST_NAME=example.test
DNS_TEST_ADDRESS=192.0.2.123
DNS_TEST_NAME_ALT=router-test.example
DNS_TEST_ADDRESS_ALT=192.0.2.124
IPFIX_ENABLED=1
IPFIX_COLLECTOR_HOST=203.0.113.10
IPFIX_COLLECTOR_PORT=4739
IPFIX_CAPTURE_INTERFACE=enp3s0
TELEMETRY_MODE=lab
TELEMETRY_SUBNET=198.18.0.0/30
TELEMETRY_HOST_ADDRESS=198.18.0.1
TELEMETRY_ROUTER_ADDRESS=198.18.0.2
TELEMETRY_HOST_INTERFACE=hvr-obs-host
TELEMETRY_ROUTER_INTERFACE=hvr-observe
ROUTER_ID=hvr-router
METRICS_EXPORT_ENABLED=1
METRICS_EXPORT_HOST=203.0.113.10
METRICS_EXPORT_PORT=9101
METRICS_EXPORT_PATH=/v1/router-metrics
METRICS_EXPORT_INTERVAL_SECONDS=5
METRICS_EXPORT_TIMEOUT_SECONDS=2
