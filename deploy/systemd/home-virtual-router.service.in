[Unit]
Description=Home Virtual Router runtime
Documentation=@HVR_DOCUMENTATION_URI@
After=network-pre.target NetworkManager.service systemd-networkd.service docker.service
Before=network.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@HVR_WORKING_DIRECTORY@
ExecStart=@HVR_EXEC_START@
ExecStop=@HVR_EXEC_STOP@
Restart=on-failure
RestartSec=10s
TimeoutStartSec=180
TimeoutStopSec=120
KillMode=mixed

[Install]
WantedBy=multi-user.target
